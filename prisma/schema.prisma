// Prisma schema - intranet-part1
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 사용자 권한(Role)
/// - HEADQUARTER: 본사
/// - DEALER: 대리점
/// - ADMIN: 시스템 관리자
enum Role {
  HEADQUARTER
  DEALER
  ADMIN
}

/// 회원가입 승인 상태
enum UserApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// 휴대폰 (숫자만 저장, 예: 01012345678)
  phone        String?
  passwordHash String
  role         Role     @default(DEALER)
  isActive     Boolean  @default(true)
  /// 최초 로그인 또는 관리자 초기화 시 비밀번호 변경 강제
  mustChangePassword Boolean @default(false)
  passwordChangedAt  DateTime?
  approvalStatus UserApprovalStatus @default(APPROVED)
  // 대리점 소속 사용자만 연결됨 (본사/관리자는 null)
  dealerId     String?
  dealer       Dealer?  @relation(fields: [dealerId], references: [id])
  posts        Post[]
  comments     Comment[]
  approvalDrafts ApprovalDocument[] @relation("ApprovalDrafter")
  approvalSteps  ApprovalStep[]     @relation("ApprovalApprover")
  downloadLogs   DownloadLog[]
  fileVersions   AttachmentVersion[] @relation("VersionUploader")
  notifications  Notification[]
  preferences    UserPreference?
  aiConversations AiConversation[]
  pilotGroups     PilotGroupMember[]
  pilotFeedbacks  PilotFeedback[]
  ordersCreated   Order[]        @relation("OrderCreator")
  rolloutFeedbacks RolloutFeedback[]
  postFolders     PostFolder[]
  postLabels      PostLabel[]
  postMailItems   PostMailItem[]
  leaveBalances   LeaveBalance[]
  leaveRequests   LeaveRequest[] @relation("LeaveRequester")
  leaveApprovals  LeaveRequest[] @relation("LeaveApprover")
  jobs            UserJob[]
  documentCategoriesOwned DocumentCategory[] @relation("DocumentCategoryOwner")
  aiKnowledgeMaterials AiKnowledgeMaterial[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@index([dealerId])
  @@index([phone])
  @@map("users")
}

/// 뉴스 키워드 분야(카테고리) — 관리자가 CRUD
model NewsCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("news_categories")
}

/// 사용자 업무 카테고리 (영업/총무/인사 등) — 관리자 CRUD
model JobCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  users     UserJob[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("job_categories")
}

/// 사용자 ↔ 업무 (복수 가능)
model UserJob {
  userId        String
  jobCategoryId String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobCategory   JobCategory @relation(fields: [jobCategoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@id([userId, jobCategoryId])
  @@index([jobCategoryId])
  @@map("user_jobs")
}

/// 게시판 정의. 하나의 베이스 시스템으로 여러 게시판을 운영한다.
/// (예: notices=공지사항, general=일반게시판, pr=홍보실, products=상품자료실)
model Board {
  id            String   @id @default(cuid())
  key           String   @unique
  name          String
  description   String?
  /// 선택 가능한 카테고리 목록 (필터/작성 시 사용)
  categories    String[] @default([])
  /// 작성 허용 권한. 비어 있으면 모든 인증 사용자가 작성 가능.
  writeRoles    Role[]   @default([])
  allowComments Boolean  @default(true)
  /// 사이드바·관리 목록 표시 순서 (작을수록 위)
  sortOrder     Int      @default(0)
  posts         Post[]
  postFolders   PostFolder[]
  postLabels    PostLabel[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sortOrder])
  @@map("boards")
}

/// 게시글
model Post {
  id          String       @id @default(cuid())
  boardId     String
  board       Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  title       String
  /// 새니타이즈된 HTML (Rich Text)
  content     String
  category    String?
  viewCount   Int          @default(0)
  isPinned    Boolean      @default(false)
  /// Pilot 데모 데이터 — 정식 배포 시 일반 사용자에게 숨김
  isDemo      Boolean      @default(false)
  /// 일정 게시판 이벤트 시작/종료 (일반 게시글은 null)
  startsAt    DateTime?
  endsAt      DateTime?
  attachments Attachment[]
  comments    Comment[]
  mailItems   PostMailItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([boardId, isPinned, createdAt])
  @@index([boardId, startsAt])
  @@index([authorId])
  @@index([title])
  @@map("posts")
}

/// 사용자별 게시판 커스텀 폴더 (Gmail 스타일)
model PostFolder {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  boardId   String
  board     Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  color     String?
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  mailItems PostMailItem[]

  @@unique([userId, boardId, slug])
  @@index([userId, boardId])
  @@map("post_folders")
}

/// 사용자별 게시판 라벨
model PostLabel {
  id          String                @id @default(cuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  boardId     String
  board       Board                 @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name        String
  color       String                @default("#3B82F6")
  sortOrder   Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  assignments PostLabelAssignment[]

  @@unique([userId, boardId, name])
  @@index([userId, boardId])
  @@map("post_labels")
}

/// 사용자별 게시글 메일함 상태 (폴더·중요·임시·휴지통)
model PostMailItem {
  id          String                @id @default(cuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId      String
  post        Post                  @relation(fields: [postId], references: [id], onDelete: Cascade)
  boardId     String
  folderId    String?
  folder      PostFolder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  isImportant Boolean               @default(false)
  isDraft     Boolean               @default(false)
  trashedAt   DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  labels      PostLabelAssignment[]

  @@unique([userId, postId])
  @@index([userId, boardId])
  @@index([userId, boardId, folderId])
  @@index([userId, boardId, trashedAt])
  @@map("post_mail_items")
}

/// 게시글 ↔ 라벨 (다대다)
model PostLabelAssignment {
  id         String       @id @default(cuid())
  mailItemId String
  mailItem   PostMailItem @relation(fields: [mailItemId], references: [id], onDelete: Cascade)
  labelId    String
  label      PostLabel    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([mailItemId, labelId])
  @@map("post_label_assignments")
}

/// 게시글 첨부파일 (여러 개)
model Attachment {
  id             String              @id @default(cuid())
  postId         String
  post           Post                @relation(fields: [postId], references: [id], onDelete: Cascade)
  filename       String
  /// 디스크에 저장된 파일명 (uploads/ 하위)
  storageKey     String
  mimeType       String
  size           Int
  currentVersion Int                 @default(1)
  versions       AttachmentVersion[]
  downloadLogs   DownloadLog[]
  createdAt      DateTime            @default(now())

  @@index([postId])
  @@map("attachments")
}

/// 첨부파일 버전 이력 (상품자료실 등)
model AttachmentVersion {
  id           String     @id @default(cuid())
  attachmentId String
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  version      Int
  filename     String
  storageKey   String
  mimeType     String
  size         Int
  note         String?
  uploadedById String
  uploadedBy   User       @relation("VersionUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([attachmentId, version])
  @@index([attachmentId])
  @@map("attachment_versions")
}

/// 파일 다운로드 로그
model DownloadLog {
  id           String     @id @default(cuid())
  attachmentId String
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  downloadedAt DateTime   @default(now())

  @@index([attachmentId])
  @@index([userId])
  @@map("download_logs")
}

/// 상품자료실 등 계층형 카테고리
model ProductCategory {
  id        String            @id @default(cuid())
  boardKey  String            @default("products")
  name      String
  slug      String
  parentId  String?
  parent    ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("CategoryTree")
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())

  @@unique([boardKey, slug])
  @@index([boardKey, parentId])
  @@map("product_categories")
}

/// 문서함 (회사 공용 또는 사용자 개인)
model DocumentCategory {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  description String?
  sortOrder   Int                @default(0)
  /// 문서번호용 업무종류 코드 (예: 인사, 총무, 전자결재)
  workTypeCode String?
  /// null = 공용(관리자), 값 있음 = 사용자 개인 문서함
  ownerId     String?
  owner       User?              @relation("DocumentCategoryOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  documents   SharedDocument[]
  approvals   ApprovalDocument[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([ownerId])
  @@map("document_categories")
}

/// 사내 공용 문서함
model SharedDocument {
  id                 String            @id @default(cuid())
  title              String
  description        String?
  /// 레거시 문자열 카테고리 (마이그레이션 호환)
  category           String?
  documentCategoryId String?
  documentCategory   DocumentCategory? @relation(fields: [documentCategoryId], references: [id], onDelete: SetNull)
  /// 문서번호 (예: 2026-인사-0831001)
  documentNumber     String?
  /// 기안일자
  draftedAt          DateTime?
  /// 결재일자
  approvedAt         DateTime?
  /// 등록(확정)일자
  registeredAt       DateTime?
  /// 외부 URL 또는 내부 게시글/결재 링크
  url                String?
  boardKey           String?
  postId             String?
  approvalDocumentId String?           @unique
  approvalDocument   ApprovalDocument? @relation(fields: [approvalDocumentId], references: [id])
  tags               String[]          @default([])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([category])
  @@index([documentCategoryId])
  @@index([documentNumber])
  @@map("shared_documents")
}

/// 뉴스 자동수집 키워드 (관리자 관리, 최대 50개)
model NewsKeyword {
  id        String   @id @default(cuid())
  keyword   String
  /// AI | 경제 | 미래
  category  String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([keyword])
  @@index([isActive, sortOrder])
  @@map("news_keywords")
}

/// 댓글
model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@map("comments")
}

/// RAG 벡터 청크 저장소(raw SQL/pgvector 로 관리). Prisma 가 삭제하지 않도록 모델로 등록만 해둔다.
model DocumentChunk {
  id         String                    @id
  sourceType String                    @map("source_type")
  sourceId   String                    @map("source_id")
  chunkIndex Int                       @map("chunk_index")
  title      String?
  url        String?
  content    String
  embedding  Unsupported("vector(384)")
  createdAt  DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([sourceType, sourceId], map: "document_chunks_source_idx")
  @@map("document_chunks")
}

/// 전자결재 문서 상태
enum ApprovalStatus {
  DRAFT // 임시저장(상신 전)
  IN_PROGRESS // 진행중
  REJECTED // 반려
  COMPLETED // 완료
}

/// 결재 단계(개별 결재자) 상태
enum ApprovalStepStatus {
  PENDING // 대기
  APPROVED // 승인
  REJECTED // 반려
}

/// 기안서 템플릿
model ApprovalTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  /// 기본 본문(HTML)
  content     String
  documents   ApprovalDocument[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("approval_templates")
}

/// 전자결재 문서(기안서)
model ApprovalDocument {
  id                 String             @id @default(cuid())
  title              String
  content            String
  status             ApprovalStatus     @default(DRAFT)
  drafterId          String
  drafter            User               @relation("ApprovalDrafter", fields: [drafterId], references: [id])
  templateId         String?
  template           ApprovalTemplate?  @relation(fields: [templateId], references: [id])
  documentCategoryId String?
  documentCategory   DocumentCategory?  @relation(fields: [documentCategoryId], references: [id], onDelete: SetNull)
  /// 문서번호 (완료 시 부여) 년도-업무종류-월일000
  documentNumber     String?            @unique
  /// 등록(확정)일자 — 문서함 보관 시점
  registeredAt       DateTime?
  archivedDocument   SharedDocument?
  linkedOrder        Order?
  leaveRequest       LeaveRequest?
  /// 현재 진행 중인 결재 단계 순서(같은 순서=병렬)
  currentOrder       Int                @default(1)
  isDemo             Boolean            @default(false)
  steps              ApprovalStep[]
  /// 기안(상신) 일자
  submittedAt        DateTime?
  /// 최종 결재 일자
  completedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([drafterId])
  @@index([status])
  @@index([documentCategoryId])
  @@map("approval_documents")
}

/// 문서번호 일련번호 (년도+업무종류+월일 단위)
model DocumentNumberSeq {
  id       String @id @default(cuid())
  year     Int
  workType String
  monthDay String
  lastSeq  Int    @default(0)

  @@unique([year, workType, monthDay])
  @@map("document_number_seqs")
}

/// 결재선의 개별 결재자 단계. stepOrder 가 같으면 병렬, 다르면 순차.
model ApprovalStep {
  id         String             @id @default(cuid())
  documentId String
  document   ApprovalDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  approverId String
  approver   User               @relation("ApprovalApprover", fields: [approverId], references: [id])
  stepOrder  Int
  /// 결재란 직책 표기 (예: 이사, 대표이사)
  title      String?
  status     ApprovalStepStatus @default(PENDING)
  comment    String?
  actedAt    DateTime?
  createdAt  DateTime           @default(now())

  @@index([documentId])
  @@index([approverId, status])
  @@map("approval_steps")
}

/// 대리점 조직. 회원가입 시 대리점 코드로 사용자와 연결된다.
model Dealer {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  region            String?
  isActive          Boolean  @default(true)
  /// 단계적 Rollout — false 이면 대리점 사용자 접근 제한
  rolloutActive     Boolean  @default(false)
  rolloutGroupId    String?
  rolloutGroup      RolloutGroup? @relation(fields: [rolloutGroupId], references: [id])
  appNameOverride   String?
  logoStorageKey    String?
  primaryColor      String?
  sidebarColor      String?
  sidebarForeground String?
  users             User[]
  inventoryItems    InventoryItem[]
  buyerOrders       Order[]       @relation("BuyerOrders")
  sellerOrders      Order[]       @relation("SellerOrders")
  tradesFrom        DealerTrade[] @relation("TradeFrom")
  tradesTo          DealerTrade[] @relation("TradeTo")
  rolloutFeedbacks  RolloutFeedback[]
  pageThemes        PageTheme[]
  pageTemplates     PageTemplate[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([rolloutGroupId])
  @@index([rolloutActive, isActive])
  @@map("dealers")
}

/// 감사 로그 (로그인 실패, 전자결재, AI 호출 등)
enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  APPROVAL_SUBMIT
  APPROVAL_APPROVE
  APPROVAL_REJECT
  AI_CHAT
  AI_DRAFT
  AI_NEWS_COLLECT
  FILE_UPLOAD
  USER_APPROVE
  USER_REJECT
  SITE_CUSTOMIZE
  AI_INGEST_RUN
  APPROVAL_CUSTOMIZE
  INTEGRATION_UPDATE
  PILOT_FEEDBACK
  SYSTEM_ERROR
  USAGE_EVENT
  PASSWORD_CHANGE
  BULK_USER_IMPORT
  EMERGENCY_NOTICE
  DEALER_ROLLOUT
  DEALER_IMPORT
  ORDER_CREATE
}

model AuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  userId    String?
  userEmail String?
  ip        String?
  userAgent String?
  resource  String?
  detail    String?
  success   Boolean     @default(true)
  createdAt DateTime    @default(now())

  @@index([action, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

/// 알림 유형
enum NotificationType {
  APPROVAL_REQUEST
  APPROVAL_RESULT
  NOTICE
  COMMENT
  AI_MENTION
  SYSTEM
  EMERGENCY
  LEAVE_REQUEST
  LEAVE_RESULT
}

/// 연차 신청 상태
enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  FULL
  HALF
}

/// 연도별 연차 잔여 (발생·사용)
model LeaveBalance {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  year        Int
  /// 발생 연차(일)
  accruedDays Float     @default(15)
  /// 승인된 사용 연차(일)
  usedDays    Float     @default(0)
  /// 연차 발생 시점
  accruedAt   DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@unique([userId, year])
  @@index([year])
  @@map("leave_balances")
}

/// 연차 사용 신청 (기안문 연동)
model LeaveRequest {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  startDate          DateTime
  endDate            DateTime
  days               Float
  leaveType          LeaveType          @default(FULL)
  reason             String?
  emergencyContact   String?
  status             LeaveRequestStatus @default(PENDING)
  approverId         String?
  approver           User?              @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  reviewNote         String?
  approvalDocumentId String?            @unique
  approvalDocument   ApprovalDocument?  @relation(fields: [approvalDocumentId], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("leave_requests")
}

/// 월말 잔여연차 메일 발송 로그
model LeaveMonthEndMailLog {
  id        String   @id @default(cuid())
  userId    String
  year      Int
  month     Int
  email     String
  remaining Float
  success   Boolean  @default(true)
  detail    String?
  createdAt DateTime @default(now())

  @@unique([userId, year, month])
  @@index([year, month])
  @@map("leave_month_end_mail_logs")
}

/// 월말 연차 촉진 공지 등록 로그 (연·월당 1회)
model LeavePromoteNoticeLog {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  postId    String?
  createdAt DateTime @default(now())

  @@unique([year, month])
  @@map("leave_promote_notice_logs")
}

/// 사용자 알림 (In-app)
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read, createdAt])
  @@map("notifications")
}

/// 사용자 설정 (프로필·알림·언어)
model UserPreference {
  userId      String  @id
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale      String  @default("ko")
  bio         String?
  notifyPush  Boolean @default(true)
  notifyEmail Boolean @default(true)
  updatedAt   DateTime @updatedAt

  @@map("user_preferences")
}

/// AI 대화 세션 (메모리)
model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  messages  AiMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  sources        Json?
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

/// 포털 브랜딩·레이아웃 (singleton)
model SiteSettings {
  id                  String   @id @default("default")
  appName             String   @default("Intranet")
  logoStorageKey      String?
  faviconStorageKey   String?
  bannerStorageKey    String?
  bannerMediaType     String?  /// image | video
  primaryColor        String   @default("222.2 47.4% 11.2%")
  sidebarColor        String   @default("222.2 47.4% 11.2%")
  sidebarForeground   String   @default("210 40% 98%")
  dashboardLayout     Json?
  /// 페이지 빌더 설정 (대시보드·배너·홍보실 등)
  pageBuilderConfig   Json?
  updatedAt           DateTime @updatedAt
  updatedById         String?

  @@map("site_settings")
}

/// GrapesJS 페이지 테마 (본사·대리점 브랜딩)
model PageTheme {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  /// primary, accent, background 등 CSS 변수
  cssVars     Json     @default("{}")
  canvasCss   String?  @db.Text
  isDefault   Boolean  @default(false)
  dealerId    String?
  dealer      Dealer?  @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  layouts     PageLayout[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dealerId])
  @@map("page_themes")
}

/// GrapesJS 페이지 템플릿 갤러리
model PageTemplate {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  category    String   /// dashboard | banner | board | landing
  targetSlug  String   /// dashboard | banner | pr
  thumbnail   String?
  projectData Json     @default("{}")
  html        String?  @db.Text
  css         String?  @db.Text
  isBuiltIn   Boolean  @default(true)
  sortOrder   Int      @default(0)
  dealerId    String?
  dealer      Dealer?  @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([targetSlug, sortOrder])
  @@index([dealerId])
  @@map("page_templates")
}

/// GrapesJS 시각적 페이지 레이아웃 (slug: dashboard | banner | board:{key} 등)
model PageLayout {
  id           String   @id @default(cuid())
  slug         String
  name         String
  /// "global" = 본사, 대리점 ID = 대리점 전용 오버라이드
  dealerId     String   @default("global")
  projectData  Json     @default("{}")
  html         String?  @db.Text
  css          String?  @db.Text
  isPublished  Boolean  @default(true)
  versionCount Int      @default(0)
  themeId      String?
  theme        PageTheme? @relation(fields: [themeId], references: [id], onDelete: SetNull)
  versions     PageLayoutVersion[]
  updatedAt    DateTime @updatedAt
  updatedById  String?

  @@unique([slug, dealerId])
  @@index([dealerId])
  @@map("page_layouts")
}

/// 레이아웃 저장 이력 (버전 관리)
model PageLayoutVersion {
  id          String     @id @default(cuid())
  layoutId    String
  layout      PageLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  version     Int
  projectData Json
  html        String?    @db.Text
  css         String?    @db.Text
  note        String?
  createdById String?
  createdAt   DateTime   @default(now())

  @@index([layoutId, version])
  @@map("page_layout_versions")
}

/// AI 재학습 작업 이력
model AiIngestJob {
  id              String    @id @default(cuid())
  triggeredById   String
  scope           String    /// all | boards | curated
  boardKeys       String[]  @default([])
  status          String    /// pending | running | completed | failed
  postsProcessed  Int       @default(0)
  chunksTotal     Int       @default(0)
  errorMessage    String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([startedAt])
  @@map("ai_ingest_jobs")
}

/// 매종이 지식 학습 정책 (singleton)
model AiLearningSettings {
  id               String   @id @default("default")
  /// 인트라넷 전체(게시글·문서함·전자결재) 학습 — 기본 ON
  learnAllIntranet Boolean  @default(true)
  /// 관리자가 지정·업로드한 추가 학습 자료
  learnCurated     Boolean  @default(true)
  /// 일상 대화·날씨·일반 뉴스 허용 (기본 ON)
  allowCasualChat  Boolean  @default(true)
  /// 관리자가 편집한 페르소나 본문 (비우면 코드 기본값)
  personaIdentity  String?  @db.Text
  /// 관리자가 편집한 추가 답변 규칙
  personaRules     String?  @db.Text
  updatedAt        DateTime @updatedAt

  @@map("ai_learning_settings")
}

/// 관리자가 지정·업로드한 매종이 추가 학습 자료
model AiKnowledgeMaterial {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  fileName    String?
  storageKey  String?
  mimeType    String?
  isActive    Boolean  @default(true)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, createdAt])
  @@map("ai_knowledge_materials")
}

/// 결재선 기본 템플릿 (부서·직급별)
model ApprovalLineTemplate {
  id          String   @id @default(cuid())
  name        String
  department  String?
  targetRole  Role?
  /// [{ approverId, stepOrder, label? }]
  steps       Json
  sortOrder   Int      @default(0)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([department])
  @@map("approval_line_templates")
}

/// SNS·외부 연동 설정
model IntegrationSetting {
  id           String   @id @default(cuid())
  provider     String   @unique /// instagram | company_web
  displayName  String
  apiKey       String?
  apiSecret    String?
  accessToken  String?
  webhookUrl   String?
  isEnabled    Boolean  @default(false)
  metadata     Json?
  updatedAt    DateTime @updatedAt

  @@map("integration_settings")
}

/// Pilot 배포 설정 (singleton)
model PilotSettings {
  id              String   @id @default("default")
  isActive        Boolean  @default(false)
  bannerTitle     String   @default("Pilot 테스트 기간")
  bannerMessage   String   @default("현재 파일럿(Pilot) 테스트 중입니다. 피드백을 남겨 주세요.")
  feedbackEnabled Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  @@map("pilot_settings")
}

/// Pilot 사용자 그룹 (예: 본사 영업팀, 관리팀)
model PilotGroup {
  id          String             @id @default(cuid())
  key         String             @unique
  name        String
  description String?
  isActive    Boolean            @default(true)
  members     PilotGroupMember[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("pilot_groups")
}

model PilotGroupMember {
  id           String     @id @default(cuid())
  pilotGroupId String
  pilotGroup   PilotGroup @relation(fields: [pilotGroupId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([pilotGroupId, userId])
  @@index([userId])
  @@map("pilot_group_members")
}

/// Pilot 피드백 (설문)
model PilotFeedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  rating    Int
  message   String
  pageUrl   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("pilot_feedbacks")
}

/// Pilot 기간 사용량 메트릭
model UsageMetric {
  id        String   @id @default(cuid())
  userId    String?
  event     String
  resource  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([createdAt])
  @@map("usage_metrics")
}

/// 시스템 에러 로그 (관리자 자동 알림)
model SystemErrorLog {
  id        String   @id @default(cuid())
  source    String
  message   String
  stack     String?
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("system_error_logs")
}

/// 긴급 공지 (전체 사용자 강제 알림 + 배너)
model EmergencyNotice {
  id             String   @id @default(cuid())
  title          String
  body           String
  isActive       Boolean  @default(true)
  sentById       String
  recipientCount Int      @default(0)
  createdAt      DateTime @default(now())
  expiresAt      DateTime?

  @@index([isActive, createdAt])
  @@map("emergency_notices")
}

/// 대리점 Rollout 그룹 (지역·단계별 활성화)
model RolloutGroup {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  dealers     Dealer[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("rollout_groups")
}

/// Rollout 피드백 (대리점 온보딩)
model RolloutFeedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealerId  String?
  dealer    Dealer?  @relation(fields: [dealerId], references: [id])
  category  String
  rating    Int
  message   String
  createdAt DateTime @default(now())

  @@index([dealerId, createdAt])
  @@map("rollout_feedbacks")
}

// ── Part 2: 주문·결제·배송·재고 ──

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ShipmentStatus {
  PREPARING
  IN_TRANSIT
  DELIVERED
  RETURNED
}

enum DealerTradeStatus {
  PROPOSED
  ACCEPTED
  COMPLETED
  CANCELLED
}

/// 상품 SKU (상품자료실 Post 와 연계 가능)
model ProductSku {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  description String?
  unitPrice   Decimal  @db.Decimal(12, 2)
  /// 상품자료실 게시글 ID (Part 1 연동)
  productPostId String?
  isActive    Boolean  @default(true)
  inventory   InventoryItem[]
  orderItems  OrderItem[]
  trades      DealerTrade[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("product_skus")
}

model InventoryItem {
  id        String     @id @default(cuid())
  dealerId  String
  dealer    Dealer     @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  skuId     String
  sku       ProductSku @relation(fields: [skuId], references: [id], onDelete: Cascade)
  quantity  Int        @default(0)
  reserved  Int        @default(0)
  updatedAt DateTime   @updatedAt

  @@unique([dealerId, skuId])
  @@map("inventory_items")
}

model Order {
  id                 String            @id @default(cuid())
  orderNumber        String            @unique
  buyerDealerId      String
  buyerDealer        Dealer            @relation("BuyerOrders", fields: [buyerDealerId], references: [id])
  sellerDealerId     String?
  sellerDealer       Dealer?           @relation("SellerOrders", fields: [sellerDealerId], references: [id])
  status             OrderStatus       @default(PENDING)
  totalAmount        Decimal           @db.Decimal(12, 2)
  approvalDocumentId String?           @unique
  approvalDocument   ApprovalDocument? @relation(fields: [approvalDocumentId], references: [id])
  createdById        String
  createdBy          User              @relation("OrderCreator", fields: [createdById], references: [id])
  items              OrderItem[]
  payment            Payment?
  shipment           Shipment?
  dealerTrade        DealerTrade?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([buyerDealerId, status])
  @@index([sellerDealerId])
  @@map("orders")
}

model OrderItem {
  id        String     @id @default(cuid())
  orderId   String
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  skuId     String
  sku       ProductSku @relation(fields: [skuId], references: [id])
  quantity  Int
  unitPrice Decimal    @db.Decimal(12, 2)

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String        @unique
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    PaymentStatus @default(PENDING)
  amount    Decimal       @db.Decimal(12, 2)
  method    String?
  paidAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("payments")
}

model Shipment {
  id          String         @id @default(cuid())
  orderId     String         @unique
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      ShipmentStatus @default(PREPARING)
  trackingNo  String?
  shippedAt   DateTime?
  deliveredAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("shipments")
}

/// 대리점 간 물품거래 (Dealer-to-Dealer)
model DealerTrade {
  id           String            @id @default(cuid())
  fromDealerId String
  fromDealer   Dealer            @relation("TradeFrom", fields: [fromDealerId], references: [id])
  toDealerId   String
  toDealer     Dealer            @relation("TradeTo", fields: [toDealerId], references: [id])
  skuId        String
  sku          ProductSku        @relation(fields: [skuId], references: [id])
  quantity     Int
  status       DealerTradeStatus @default(PROPOSED)
  orderId      String?           @unique
  order        Order?            @relation(fields: [orderId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([fromDealerId, status])
  @@index([toDealerId, status])
  @@map("dealer_trades")
}
