# ──────────────────────────────────────────────
# Production Docker Compose 환경변수 템플릿
# 사용법: cp .env.production.example .env.production 후 값 수정
# ──────────────────────────────────────────────

# ── PostgreSQL ──
POSTGRES_USER=intranet
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=intranet
POSTGRES_PORT=5432

# ── Redis (Rate Limit + Cache) ──
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ── App / NextAuth ──
# ⚠️ 본사 배포 시 반드시 변경
NEXTAUTH_URL=http://localhost:8080
# openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32

# DATABASE_URL 은 entrypoint 가 POSTGRES_* 로 자동 조립합니다.
# 본사 서버 기동 시 반드시:
#   docker compose --env-file .env.production up -d --build
# 또는 .env.production 을 .env 로 복사해 두세요.
# (없으면 Compose 가 비밀번호를 기본값으로 넣어 App↔DB 인증 실패 → 502)

# ── 포트 (온프레미스 방화벽) ──
HTTP_PORT=8080
APP_PORT=3000

# ── Prisma / DB ──
# migrate deploy 우선 (true 권장). 기존 db push DB는 DEPLOY.md "기존 DB baseline" 참고
PRISMA_MIGRATE_DEPLOY=true
PRISMA_ACCEPT_DATA_LOSS=false
# 최초 1회 true → 시드 후 false (운영: false 유지)
RUN_SEED=false

# ── Pilot (Phase 6) ──
# Pilot 배포 시 true — Pilot 배너·피드백·사용량 추적 활성화
PILOT_MODE=false
# 최초 Pilot 1회 true → 데모 데이터(공지·게시·결재) 생성 후 false
RUN_DEMO_SEED=false

# Phase 8 — 대리점 SKU·재고·샘플 주문 (최초 1회)
RUN_DEALER_DEMO_SEED=false

# Nginx 프록시 뒤에서 실행 시 true (보안 헤더 중복 방지)
BEHIND_NGINX=true

NODE_ENV=production
LOG_LEVEL=info

# ── Security / CORS ──
# 쉼표 구분 — 본사 도메인 + 내부 접속 URL
ALLOWED_ORIGINS=http://localhost:8080,http://intranet.company.local
# 사내망 IP 대역 prefix
ALLOWED_IP_PREFIXES=127.0.0.1,10.,172.16.,172.17.,172.18.,192.168.

# ── AI / RAG (선택) ──
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# CRON_SECRET=change-me

# ── ClamAV (선택 — 파일 바이러스 스캔) ──
# CLAMAV_HOST=clamav:3310
