# ──────────────────────────────────────────────
# Production Docker Compose 환경변수 템플릿
# 사용법: cp .env.production.example .env.production 후 값 수정
# ──────────────────────────────────────────────

# ── PostgreSQL ──
POSTGRES_USER=intranet
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=intranet
POSTGRES_PORT=5432

# ── Redis (Rate Limit + Cache) ──
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ── App / NextAuth ──
# ⚠️ 본사 배포 시 반드시 변경
NEXTAUTH_URL=http://localhost:8080
# openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32

# DATABASE_URL은 docker-compose.yml app.environment 에서 자동 주입됨
# DATABASE_URL=postgresql://intranet:PASSWORD@db:5432/intranet?schema=public

# ── 포트 (온프레미스 방화벽) ──
HTTP_PORT=8080
APP_PORT=3000

# ── Prisma / DB ──
# migrate deploy 우선 (true 권장). 기존 db push DB는 DEPLOY.md "기존 DB baseline" 참고
PRISMA_MIGRATE_DEPLOY=true
PRISMA_ACCEPT_DATA_LOSS=false
# 최초 1회 true → 시드 후 false (운영: false 유지)
RUN_SEED=false

# ── Pilot (Phase 6 / Sprint #1) ──
# Pilot 배포 시 true — 사이드바 approval/documents/search 노출 · Pilot 배너 · KPI
PILOT_MODE=false
# 클라이언트 nav 동기화 (로컬 dev 시 PILOT_MODE와 동일하게 설정)
NEXT_PUBLIC_PILOT_MODE=false
# 최초 Pilot 1회 true → 데모+결재 시드 후 false
RUN_DEMO_SEED=false
RUN_PILOT_SEED=false

# Phase 8 — 대리점 SKU·재고·샘플 주문 (최초 1회)
RUN_DEALER_DEMO_SEED=false

# Nginx 프록시 뒤에서 실행 시 true (보안 헤더 중복 방지)
BEHIND_NGINX=true

NODE_ENV=production
LOG_LEVEL=info

# ── Security / CORS ──
# 쉼표 구분 — 본사 도메인 + 내부 접속 URL
ALLOWED_ORIGINS=http://localhost:8080,http://intranet.company.local
# 사내망 IP 대역 prefix
ALLOWED_IP_PREFIXES=127.0.0.1,10.,172.16.,172.17.,172.18.,192.168.

# ── AI / RAG (선택) ──
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# CRON_SECRET=change-me

# ── ClamAV (선택 — 파일 바이러스 스캔) ──
# CLAMAV_HOST=clamav:3310

# ── Firebase Hybrid (Phase 5: 기본 비활성) ──
FIREBASE_ENABLED=false
# FIREBASE_AUTH_ENABLED=true
# FIREBASE_STORAGE_ENABLED=true
# FIREBASE_FIRESTORE_ENABLED=true
# FIREBASE_MESSAGING_ENABLED=true
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# FIREBASE_SERVICE_ACCOUNT_JSON=
