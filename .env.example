# ──────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────
POSTGRES_USER=intranet
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=intranet
POSTGRES_PORT=5432

DATABASE_URL="postgresql://intranet:CHANGE_ME_STRONG_PASSWORD@localhost:5432/intranet?schema=public"

# ──────────────────────────────────────────────
# Redis (Rate Limit + Cache)
# ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ──────────────────────────────────────────────
# NextAuth.js
# ──────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32

# ──────────────────────────────────────────────
# CORS / Security
# ──────────────────────────────────────────────
# 쉼표 구분 — 본사 도메인 + 내부 IP
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_IP_PREFIXES=127.0.0.1,10.,172.16.,172.17.,192.168.

# ──────────────────────────────────────────────
# AI / RAG (선택)
# ──────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# CRON_SECRET=change-me

# ──────────────────────────────────────────────
# ClamAV (선택 — 파일 바이러스 스캔)
# ──────────────────────────────────────────────
# CLAMAV_HOST=clamav:3310

# ──────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development

# ──────────────────────────────────────────────
# Docker Production (참고)
# ──────────────────────────────────────────────
# HTTP_PORT=8080
# RUN_SEED=false
