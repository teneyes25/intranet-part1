# ──────────────────────────────────────────────
# Production Docker Compose 환경변수 템플릿
# 사용법: cp .env.production.example .env.production 후 값 수정
# ──────────────────────────────────────────────

# ── PostgreSQL ──
POSTGRES_USER=intranet
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=intranet
POSTGRES_PORT=5432

# ── Redis (Rate Limit + Cache) ──
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ── App / NextAuth ──
# ⚠️ 사내 다른 PC에서 접속할 실제 URL로 설정 (호스트 IP 권장)
# 사무실 PC 예: NEXTAUTH_URL=http://192.168.0.16:8080
NEXTAUTH_URL=http://192.168.0.16:8080
# openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32

# DATABASE_URL은 docker-compose.yml app.environment 에서 자동 주입됨
# DATABASE_URL=postgresql://intranet:PASSWORD@db:5432/intranet?schema=public

# ── 포트 (온프레미스 방화벽) ──
# Nginx 공개 포트 — 호스트 3000과 충돌하지 않도록 8080 사용
HTTP_PORT=8080
# App 직접 노출 시에만 사용 (기본 compose에서는 미노출). 3000 피함
APP_PORT=3001

# ── Prisma / DB ──
# migrate deploy 우선 (true 권장). 기존 db push DB는 DEPLOY.md "기존 DB baseline" 참고
PRISMA_MIGRATE_DEPLOY=true
PRISMA_ACCEPT_DATA_LOSS=false
# 최초 1회 true → 시드 후 false (운영: false 유지)
RUN_SEED=false

# 데모 게시물 시드 (선택 — 운영에서는 false)
RUN_DEMO_SEED=false

# 대리점 SKU·재고·샘플 주문 시드 (최초 1회)
RUN_DEALER_DEMO_SEED=false

# Nginx 프록시 뒤에서 실행 시 true (보안 헤더 중복 방지)
BEHIND_NGINX=true

NODE_ENV=production
LOG_LEVEL=info

# ── Security / CORS ──
# 쉼표 구분 — NEXTAUTH_URL과 동일 origin 포함 필수
ALLOWED_ORIGINS=http://192.168.0.16:8080,http://localhost:8080,http://127.0.0.1:8080
# 사내망 IP 대역 prefix
ALLOWED_IP_PREFIXES=127.0.0.1,10.,172.16.,172.17.,172.18.,172.19.,172.20.,172.21.,172.22.,172.23.,172.24.,172.25.,172.26.,172.27.,172.28.,172.29.,172.30.,172.31.,192.168.

# ── AI / RAG (선택) ──
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# CRON_SECRET=change-me

# ── ClamAV (선택 — 파일 바이러스 스캔) ──
# CLAMAV_HOST=clamav:3310
